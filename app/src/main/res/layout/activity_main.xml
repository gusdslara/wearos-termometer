<?xml version="1.0" encoding="utf-8"?>
<!-- Wearable Full Screen Layout - Zero Scroll required -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Top Mode Indicator Pill & Auto-detection (Clickable to manual toggle) -->
    <LinearLayout
        android:id="@+id/btnModeToggle"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_status_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/imgModeIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_wrist" />

        <TextView
            android:id="@+id/txtModeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="PULSO (AUTO)"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtModeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="⇄"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Center circular gauge & temperature display area -->
    <RelativeLayout
        android:id="@+id/centerGaugeLayout"
        android:layout_width="126dp"
        android:layout_height="126dp"
        android:layout_centerInParent="true">

        <!-- Outer gauge ring -->
        <View
            android:id="@+id/outerRing"
            android:layout_width="126dp"
            android:layout_height="126dp"
            android:background="@drawable/bg_meter_ring" />

        <!-- Center Temperature or Placeholder/Prompt -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="--.-"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:layout_marginTop="3dp"
                    android:text="°C"
                    android:textColor="#FF7043"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- State badge (PRONTO / NORMAL / BAIXA / etc) -->
            <TextView
                android:id="@+id/txtStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_status_card"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="TOQUE EM MEDIR"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Scanning spinner -->
            <ProgressBar
                android:id="@+id/progressScanning"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="2dp"
                android:indeterminateTint="#FF7043"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Subtitle instruction guideline right above the button -->
    <TextView
        android:id="@+id/txtSubInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnMeasure"
        android:layout_marginBottom="3dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="No pulso detectado"
        android:textColor="#64748B"
        android:textSize="9sp" />

    <!-- Bottom Measure Button - Always completely in view without scrolling -->
    <FrameLayout
        android:id="@+id/btnMeasure"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_button_measure"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/txtMeasureAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:letterSpacing="0.05"
            android:text="MEDIR"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

</RelativeLayout>
